{
  "name": "geopackage",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "report": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"**/*.{html,vue,css,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged -c ./.husky/lintstagedrc.js",
    "lint:pretty": "pretty-quick --staged",
    "lint": "lint:eslint && yarn lint:prettier && yarn lint:stylelint",
    "test": "vitest",
    "prepare": "husky install"
  },
  "dependencies": {
    "@pureadmin/utils": "^1.9.6",
    "@turf/turf": "^6.5.0",
    "ansi_up": "^5.1.0",
    "axios": "^1.7.2",
    "body-parser": "^1.20.2",
    "colormap": "^2.3.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dat.gui": "^0.7.9",
    "dayjs": "^1.11.10",
    "vue": "^3.2.45",
    "vue-demi": "^0.14.7",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.6",
    "@commitlint/config-conventional": "^17.6.6",
    "@edge-runtime/vm": "^3.2.0",
    "@pureadmin/table": "^3.1.2",
    "@types/cesium": "1.67.13",
    "@types/node": "^18.14.2",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "css-properties-sorting": "^1.0.10",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-html": "^7.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.9.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "picocolors": "^1.0.0",
    "postcss": "^8.4.21",
    "postcss-html": "^1.5.0",
    "postcss-preset-env": "^8.0.1",
    "postcss-px-to-viewport-8-plugin": "^1.2.0",
    "postcss-pxtorem": "^6.0.0",
    "postcss-scss": "^4.0.6",
    "prettier": "^2.8.4",
    "pretty-quick": "^3.1.3",
    "recursive-copy": "^2.0.14",
    "rollup-plugin-external-globals": "^0.10.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.58.3",
    "stylelint": "^15.2.0",
    "stylelint-config-standard": "^30.0.1",
    "stylelint-config-standard-scss": "^7.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^6.0.2",
    "stylelint-plugin-stylus": "^0.18.0",
    "stylelint-scss": "^4.4.0",
    "typescript": "^4.9.3",
    "vite": "^4.1.0",
    "vite-plugin-cdn-import": "^0.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-externals": "^0.6.2",
    "vite-plugin-html-config": "^1.0.11",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-resolve-externals": "^0.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^1.4.0",
    "vue-tsc": "^1.0.24"
  }
}
